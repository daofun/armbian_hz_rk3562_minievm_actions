/*
 * Copyright (c) 2022 Rockchip Electronics Co., Ltd.
 *
 * HZ-RK3562 MiniEVM - ported from vendor SDK kernel-5.10 to Rockchip BSP 6.1
 * (armbian/linux-rockchip rk-6.1-rkr7.2). Changes vs. vendor 5.10:
 *  - removed duplicate #include "rk3562-rk809.dtsi" (already in hzhy_rk3562_mini.dtsi)
 *  - DSI flags: MIPI_DSI_MODE_VIDEO_HBP -> MIPI_DSI_MODE_VIDEO_NO_HBP,
 *               MIPI_DSI_MODE_EOT_PACKET -> MIPI_DSI_MODE_NO_EOT_PACKET
 *    (6.1 renamed macros, identical bit values => identical behaviour)
 *  - disabled EVB touchscreen nodes (gt1x@14, hynitron@5a) inherited from
 *    rk3562-evb.dtsi: not present on this board, they toggled GPIO0_A0/GPIO0_B0
 */
#include "hzhy_rk3562_mini.dtsi"
#include "HZ-MiniEVM_EXP.dtsi"

/ {
	version = "v1.1.0_20250321";
};

&rknpu {
    status = "okay";
};

&rknpu_mmu {
    status = "okay";
};

&sai0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0m0_lrck
		     &i2s0m0_sclk
		     &i2s0m0_sdi0
		     &i2s0m0_sdo0>;
};

&spdif_8ch {
	pinctrl-0 = <&spdifm0_pins>;
	status = "disabled";
};

&vcc3v3_lcd_n {
	gpio = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-always-on;
	regulator-boot-on;
	startup-delay-us = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_pwr_en>;
	vin-supply = <&vcc5v0_sys>;
};



//=================================================================
//USB2.0
&u2phy {
	status = "okay";
};

&u2phy_host {
	status = "okay";
	phy-supply = <&vcc5v0_usb_host>;
};

&u2phy_otg {
	status = "okay";
	vbus-supply = <&vcc5v0_usb_otg>;
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

//==================================================================
//USB3.0
&usbdrd30 {
	status = "okay";
};

&combphy_pu {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
        dr_mode = "otg";
	extcon = <&u2phy>;
        phys =  <&u2phy_otg>, <&combphy_pu PHY_TYPE_USB3>;
        phy-names = "usb2-phy", "usb3-phy";
};

//==================================================================
//网口 rtl8211  eth0
&gmac0 {
	/* Use rgmii-rxid mode to disable rx delay inside Soc */
	phy-mode = "rgmii-rxid";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio0 RK_PA3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* Reset time is 20ms, 100ms for rtl8211f */
	snps,reset-delays-us = <0 20000 100000>;

	tx_delay = <0x42>;

	pinctrl-names = "default";
	pinctrl-0 = <&rgmiim0_miim
		     &rgmiim0_tx_bus2
		     &rgmiim0_rx_bus2
		     &rgmiim0_rgmii_clk
		     &rgmiim0_rgmii_bus
             >;

	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&mdio0 {
	rgmii_phy0: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		clocks = <&cru CLK_GMAC_ETH_OUT2IO>;
		assigned-clocks = <&cru CLK_GMAC_ETH_OUT2IO>;
		assigned-clock-rates = <25000000>;
	};
};

//8512 eth1
&gmac1 {
	status = "okay";
	/* Use rgmii-rxid mode to disable rx delay inside Soc */
	phy-mode = "rmii";
	clock_in_out = "input";

	snps,reset-gpio = <&gpio1 RK_PC6 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* Reset time is 20ms, 100ms for rtl8211f */
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&rmii_pins
		     &ethm1_pins>;

	phy-handle = <&rmii_phy1>;	
};

&mdio1 {
	rmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		clocks = <&cru CLK_GMAC_ETH_OUT2IO>;
		assigned-clocks = <&cru CLK_GMAC_ETH_OUT2IO>;
		assigned-clock-rates = <25000000>;
	};
};

//==================================================================
//SD
&sdmmc0 {
	max-frequency = <150000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	status = "okay";
};

&vccio_acodec{
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        regulator-name = "vccio_acodec";
        regulator-state-mem {
                regulator-off-in-suspend;
        };
};

//==================================================================
//RS485
&uart6 {
     pinctrl-names = "default";
     pinctrl-0 = <&uart6m0_xfer>;
     status = "disabled";
};


//==================================================================
//MIPI camera imx415  
 &i2c5{
     status = "okay";
     pinctrl-names = "default";
     pinctrl-0 = <&i2c5m0_xfer>;
	
     ov13850_1: ov13850_1@36 {
         status = "okay";
         compatible = "ovti,ov13855";
	
         reg = <0x36>;
		
         clocks = <&cru CLK_CAM0_OUT2IO>;
         clock-names = "xvclk";
         pinctrl-names = "rockchip,camera_default";
         pinctrl-0 = <&camm0_clk0_out>;

 		reset-gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
 	 	pwdn-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;

 		avdd-supply = <&vcc2v8_dvp>;
 		dvdd-supply = <&vcc_mipicsi0>;
 		dovdd-supply = <&vcc1v8_dvp>;
        
         rockchip,camera-module-index = <1>;
         rockchip,camera-module-facing = "back";
         rockchip,camera-module-name = "KYT-10203-v1";
         rockchip,camera-module-lens-name = "default";
	

 		port {
             ov13850_out0: endpoint {
                 remote-endpoint = <&mipi_in_ucam0>;
                 data-lanes = <1 2 3 4>;
             };
         };
     };

     gc05a2_dphy1: gc05a2-0@37 {
         compatible = "galaxycore,gc05a2";
         status = "okay";
         reg = <0x37>;
     
         clocks = <&cru CLK_CAM0_OUT2IO>;
         clock-names = "xvclk";
         pinctrl-names = "rockchip,camera_default";
         pinctrl-0 = <&camm0_clk0_out>;
     
                 reset-gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
                 pwdn-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
     
                 avdd-supply = <&vcc2v8_dvp>;
                 dvdd-supply = <&vcc_mipicsi0>;
                 dovdd-supply = <&vcc1v8_dvp>;
         rockchip,camera-module-index = <0>;
         rockchip,camera-module-facing = "back";
         rockchip,camera-module-name = "KYT-11210-V2";
         rockchip,camera-module-lens-name = "default";
     
         port {
                 gc05a2_out_dphy0: endpoint {
                     remote-endpoint = <&mipi_in_gc05a2_0>;
                     data-lanes = <1 2>;
                 };
             };
         };
 };
//MIPI cif isp

