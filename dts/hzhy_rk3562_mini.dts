			05 78 01 11
			05 1E 01 29
		];

		panel-exit-sequence = [
			05 00 01 28
			05 00 01 10
		];

		disp_timings0: display-timings {
			native-mode = <&dsi_timing0>;
			dsi_timing0: timing0 {
				clock-frequency = <149000000>;
				hactive = <1920>;
				vactive = <1080>;
				hfront-porch = <90>; 
				hsync-len = <45>;
				hback-porch = <145>; 
				vfront-porch = <4>; 
				vsync-len = <5>; 
				vback-porch = <36>; 
				hsync-active = <0>; 
				vsync-active = <1>; 
				de-active = <0>; 
				pixelclk-active = <0>; 
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};

};



// rk3562-evb.dtsi 在 i2c2 上挂了 EVB 的触摸屏，本板没有，禁用
&gt1x {
	status = "disabled";
};

&hynitron {
	status = "disabled";
};

// MIPI -> HDMI 桥接芯片
&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_xfer>;

	lt8912b: lt8912b@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
//		mux-gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};


//==================================================================
//PCIE 2.0

&pcie2x1 {
	reset-gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie20>;
	status = "disabled";
};

//ADC

&saradc0 {
 status = "okay";
 vref-supply = <&adc_ref>;
};

&saradc1 {
 status = "okay";
 vref-supply = <&adc_ref>;
};

&uart6 {
     pinctrl-names = "default";
     pinctrl-0 = <&uart6m0_xfer>;
     status = "okay";
};

&pinctrl {
    pinctrl-names = "default";
    pinctrl-0 = <&user_gpios>;
    wusb3801 {
        wusb3801_int_pin: wusb3801-int-pin {
            rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
        };
        ch482d_sel_pin: ch482d-sel-pin {
            rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    usb0 {
        usb_otg_pwren: usb_otg_pwren {
            rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    headphone {
        hp_det: hp-det {
            rockchip,pins = <3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    sdcard_det_pin {
        carddet_pin: carddet-pin {
            rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
        };
    };

    lcd {
        lcd_rst_gpio: lcd-rst-gpio {
            rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    sdio-pwrseq {
        wifi_enable_h: wifi-enable-h {
            rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    lcd {
        lcd_pwr_en: lcd-pwr-en {
            rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
        };
    };

    cam {
        mipicsi0_pwr: mipicsi0-pwr {
            rockchip,pins =
                /* camera power en */
                <1 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    ft5406_INT {
        ft5406_INT: ft5406_INT-pins {
            rockchip,pins =
                <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    backlight {
        bl_en_gpio: bl-en-gpio {
            rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    usergpio {
        user_gpios: user-gpios {
            rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,    //REFCLK_OUT/GPIO0_A0
                            <3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>,    //UART4_RX_M0/GPIO3_D1
                            <1 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>,    //PWM8_M1/GPIO1_C1
                            <1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,    //PWM9_M1/GPIO1_C2
                            <3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI2_MOSI_M0/GPIO3_D3
                            <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI2_MISO_M0/GPIO3_D2
                            <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI2_CLK_M0/GPIO4_B6
                            <3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>,    //UART2_RX_M1/CAN0_RX_M0/GPIO3_A1
                            <3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>,    //UART4_CTSN_M0/GPIO3_C5
                            // <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,    //UART5_TX_M1/GPIO3_A6
                            // <3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>,    //UART7_TX_M0/GPIO3_C4
                            // <3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>,    //UART5_RX_M1/GPIO3_A7
                            // <3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>,    //UART7_RX_M0/GPIO3_C7
                            // <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>,    //UART6_RX_M0/GPIO0_C7
                            // <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>,    //UART6_TX_M0/GPIO0_C6
                            <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,    //CLK32K_OUT0/GPIO0_B0
                            <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>,    //I2C4_SCL_M1/GPIO0_A5
                            <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>,    //CAN1_TX_M1/GPIO0_C0
                            <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI0_MOSI_M0/GPIO0_C4
                            <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI2_CS0_M0/I2C1_SDA_M1/GPIO4_B5
                            <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI2_CS1_M0/I2C1_SCL_M1/GPIO4_B4
                            <3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,    //UART2_TX_M1/CAN0_TX_M0/GPIO3_A0
                            <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,    //RGMII_RXER/GPIO4_B0
                            <4 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>,    //RGMII_CLK/GPIO4_B7
                            <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>,    //ETH_REFCLKO_25M_M0/GPIO4_B1
                            <1 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>,    //PWM0_M1/GPIO1_C5
                            <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>,    //PWM11_M1/GPIO1_C4
                            <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI0_CLK_M0/GPIO0_C3
                            <0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,    //SPI0_CS0_M0/GPIO0_C2
                            <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;    //SPI0_MISO_M0/GPIO0_C5
        };
    };

};

//耳机
//录音
&pdm {
	status = "disabled";
};

