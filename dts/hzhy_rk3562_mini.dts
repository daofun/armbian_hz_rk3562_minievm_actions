    status = "okay";
};

&rkcif_mmu{
    status = "okay";
};

&rkisp {
    status = "okay";
};

&rkisp_mmu {
    status = "okay";
};

&csi2_dphy0_hw {
    status = "okay";
};
&csi2_dphy1_hw {
    status = "okay";
};


//U14
&csi2_dphy0 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_in_gc05a2_0: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&gc05a2_out_dphy0>;
                data-lanes = <1 2>;
            };

            mipi_in_ucam0: endpoint@2 {
                reg = <1>;
                remote-endpoint = <&ov13850_out0>;
                data-lanes = <1 2 3 4>;
            };
        };
        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
            csidcphy0_out: endpoint@0 {
                    reg = <0>;
                    remote-endpoint = <&mipi0_csi2_input>;
            };
        };
    };
};


&mipi0_csi2 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
            mipi0_csi2_input: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&csidcphy0_out>;
            };
        };
        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
            mipi0_csi2_output: endpoint@0 {
                reg = <0>;
                remote-endpoint = <&cif_mipi_in0>;
            };
        };
    };
};


&rkcif_mipi_lvds {
    status = "okay";
    port {
        cif_mipi_in0: endpoint {
            remote-endpoint = <&mipi0_csi2_output>;
        };
    };
};

&rkcif_mipi_lvds_sditf {
    status = "okay";
    port {
        mipi0_lvds_sditf: endpoint {
            remote-endpoint = <&isp_vir0>;
        };
    };
};

&rkisp_vir0 {
    status = "okay";
    port {
        #address-cells = <1>;
        #size-cells = <0>;
        isp_vir0: endpoint@0 {
            reg = <0>;
            remote-endpoint = <&mipi0_lvds_sditf>;
        };
    };
};

&i2c4{
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&i2c4m0_xfer>;

   /*DPHY1 U15 rkisp_vir1*/
   
    ov13850_2: ov13850_2@36 {
        status = "okay";
        compatible = "ovti,ov13855";
        reg = <0x36>;
		
        
        clocks = <&cru CLK_CAM1_OUT2IO>;
        clock-names = "xvclk";
		
		
        pinctrl-names = "default";
        pinctrl-0 = <&camm0_clk1_out>;
		
     	reset-gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_HIGH>;
	 	pwdn-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;

		avdd-supply = <&vcc2v8_dvp>;
		dvdd-supply = <&vcc_mipicsi0>;
		dovdd-supply = <&vcc1v8_dvp>;
  		
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "KYT-10203-v1";
        rockchip,camera-module-lens-name = "default";
		
        port {
            imx415_out1: endpoint {
                remote-endpoint = <&mipi_in_ucam1>;
                data-lanes = <1 2 3 4>;
            };
        };
    };

    gc05a2_dphy0: gc05a2-1@37 {
        compatible = "galaxycore,gc05a2";
        status = "okay";
        reg = <0x37>;
        clocks = <&cru CLK_CAM1_OUT2IO>;
        clock-names = "xvclk";
    
    
        pinctrl-names = "default";
        pinctrl-0 = <&camm0_clk1_out>;
    
        reset-gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_HIGH>;
                pwdn-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
    
                avdd-supply = <&vcc2v8_dvp>;
                dvdd-supply = <&vcc_mipicsi0>;
                dovdd-supply = <&vcc1v8_dvp>;
    
        rockchip,camera-module-index = <1>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "KYT-11210-V2";
        rockchip,camera-module-lens-name = "default";
        port{
                gc05a2_out_dphy1: endpoint {
                    remote-endpoint = <&mipi_in_gc05a2_1>;
                    data-lanes = <1 2>;
            };
        };
    };
};

//U15
&csi2_dphy3 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_in_gc05a2_1: endpoint@1 {                                                                                                                    
                reg = <1>;
                remote-endpoint = <&gc05a2_out_dphy1>;
                data-lanes = <1 2>;
            };

            mipi_in_ucam1: endpoint@2 {
                reg = <1>;
                remote-endpoint = <&imx415_out1>;
                data-lanes = <1 2 3 4>;
            };
        };
        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
            csidcphy1_out: endpoint@0 {
                    reg = <0>;
                    remote-endpoint = <&mipi2_csi2_input>;
            };
        };
    };
};


&mipi2_csi2 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
            mipi2_csi2_input: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&csidcphy1_out>;
            };
        };
        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
            mipi2_csi2_output: endpoint@0 {
                reg = <0>;
                remote-endpoint = <&cif_mipi_in2>;
            };
        };
    };
};

&rkcif_mipi_lvds2 {
    status = "okay";
    port {
        cif_mipi_in2: endpoint {
            remote-endpoint = <&mipi2_csi2_output>;
        };
    };
};

&rkcif_mipi_lvds2_sditf {
    status = "okay";
    port {
        mipi2_lvds_sditf: endpoint {
            remote-endpoint = <&isp_vir1>;
        };
    };
};

&rkisp_vir1 {
    status = "okay";
    port {
        #address-cells = <1>;
        #size-cells = <0>;
        isp_vir1: endpoint@0 {
            reg = <0>;
            remote-endpoint = <&mipi2_lvds_sditf>;
        };
    };
};

&i2c1{
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m0_xfer>;

	wusb3801: tcpc@60 {
		status = "okay";
		compatible = "willsemi,wusb3801";
		reg = <0x60>;
		pinctrl-names = "default";
		pinctrl-0 = <&wusb3801_int_pin &ch482d_sel_pin>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA2 IRQ_TYPE_LEVEL_LOW>;
		ch482d_sel-gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_LOW>;
	};
};


